const { MongoClient, ObjectId } = require('mongodb');

const uri = process.env.MONGODB_URI;
const dbName = process.env.MONGODB_DB || 'safe-water-web';

if (!uri) {
  throw new Error('MONGODB_URI is not configured');
}

const client = new MongoClient(uri);

let database = null;
let connecting = null;

async function connectDB() {
  if (database) return database;

  if (!connecting) {
    connecting = client.connect()
      .then(() => {
        database = client.db(dbName);
        console.log(`✅ MongoDB connected: ${dbName}`);
        return database;
      })
      .catch((error) => {
        connecting = null;
        throw error;
      });
  }

  return connecting;
}

async function initDB() {
  const db = await connectDB();

  await db.collection('users').createIndex(
    { email: 1 },
    { unique: true }
  );

  await db.collection('userSettings').createIndex(
    { user_id: 1 },
    { unique: true }
  );

  await db.collection('alerts').createIndex(
    { created_at: -1 }
  );

  console.log('✅ MongoDB collections and indexes ready');
}

async function findUserByEmail(email) {
  const db = await connectDB();

  return db.collection('users').findOne({
    email: String(email).trim().toLowerCase()
  });
}

async function findUserById(id) {
  const db = await connectDB();

  try {
    return db.collection('users').findOne({
      _id: new ObjectId(id)
    });
  } catch {
    return null;
  }
}

async function createUser(name, email, hashedPassword) {
  const db = await connectDB();

  const user = {
    name: String(name).trim(),
    email: String(email).trim().toLowerCase(),
    password: hashedPassword,
    created_at: new Date()
  };

  const result = await db.collection('users').insertOne(user);

  user._id = result.insertedId;

  await db.collection('userSettings').insertOne({
    user_id: user._id,
    family_size: 4,
    water_can_cost: 80,
    hydration_goal: 8
  });

  return user;
}

async function getSettings(userId) {
  const db = await connectDB();

  const objectId = new ObjectId(userId);

  let settings = await db.collection('userSettings').findOne({
    user_id: objectId
  });

  if (!settings) {
    settings = {
      user_id: objectId,
      family_size: 4,
      water_can_cost: 80,
      hydration_goal: 8
    };

    await db.collection('userSettings').insertOne(settings);
  }

  return settings;
}

async function updateSettings(
  userId,
  familySize,
  waterCanCost,
  hydrationGoal
) {
  const db = await connectDB();

  const objectId = new ObjectId(userId);

  const settings = {
    family_size: Number(familySize),
    water_can_cost: Number(waterCanCost),
    hydration_goal: Number(hydrationGoal)
  };

  if (
    !Number.isFinite(settings.family_size) ||
    !Number.isFinite(settings.water_can_cost) ||
    !Number.isFinite(settings.hydration_goal)
  ) {
    throw new Error('Invalid settings values');
  }

  await db.collection('userSettings').updateOne(
    { user_id: objectId },
    {
      $set: settings,
      $setOnInsert: {
        user_id: objectId
      }
    },
    { upsert: true }
  );

  return getSettings(userId);
}

async function getAlerts(limit = 50) {
  const db = await connectDB();

  return db.collection('alerts')
    .find({})
    .sort({ created_at: -1 })
    .limit(Number(limit) || 50)
    .toArray();
}

async function createAlert(title, location, type, author) {
  const db = await connectDB();

  const alert = {
    title: String(title).trim(),
    location: String(location).trim(),
    type: String(type).trim(),
    author: String(author).trim(),
    created_at: new Date()
  };

  const result = await db.collection('alerts').insertOne(alert);

  return {
    ...alert,
    _id: result.insertedId
  };
}

module.exports = {
  connectDB,
  initDB,
  findUserByEmail,
  findUserById,
  createUser,
  getSettings,
  updateSettings,
  getAlerts,
  createAlert
};
